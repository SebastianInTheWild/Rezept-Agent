# Rezept-Agent – nur das, was vor dem Start feststehen muss.
# In Portainer unter „Environment variables“ eintragen (oder als .env für Docker Compose; die .env gehört nicht ins Repo).
# Alles andere – Claude, Tandoor, Slack, KI-Fotos, Wochenplan, GitHub-Sicherung, Abgleich – stellst du in der
# Weboberfläche unter „Einstellungen“ ein. Die Werte liegen dann in daten/umgebung.json und gelten nach einem Neustart.

# Ordner auf dem Docker-Host für Zeitplan, Agenten und Daten (Standard ./ = neben der Compose-Datei).
# In Portainer einen absoluten Pfad eintragen (z. B. /home/benutzer/docker/rezepte) – ./ zeigt dort in Portainers eigenen Stack-Ordner.
AGENTS_HOST_DIR=./

# Zeitzone für Zeitplan, Log und Slack-Meldungen
TZ=Europe/Berlin

# Passwort für die Weboberfläche (leer = kein Login)
WEB_PASSWORT=
# Ohne Passwort trotzdem Zugangsdaten in der Weboberfläche ändern – nur, wenn die Seite anders geschützt ist
# (z. B. Access List im Nginx Proxy Manager: nur Heimnetz). Lässt sich absichtlich nur hier/in Portainer setzen.
# WEB_ZUGANGSDATEN_OHNE_PASSWORT=an

# Optional für den Stack: Benutzer im Container (Besitzer des Ordners), Adresse der Weboberfläche, Image-Tag
# PUID=1000
# PGID=1000
# WEB_DOMAIN=rezepte.example.com
# IMAGE_TAG=latest
