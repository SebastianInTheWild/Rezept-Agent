# Sprache / language: de (Standard) oder en – Rezepte, Slack-Nachrichten, Weboberfläche (auch unter Einstellungen wählbar)
# SPRACHE=de

# Zugangsdaten – in Portainer unter „Environment variables“ eintragen (oder kopieren nach .env für Docker Compose).
# Die .env gehört nicht ins Repo. Nach Änderungen den Stack neu bereitstellen.

# Claude: auf einem Rechner mit Claude Code „claude setup-token“ ausführen und den Token hier eintragen
CLAUDE_CODE_OAUTH_TOKEN=
# Alternativ ein API-Schlüssel (Abrechnung pro Lauf):
# ANTHROPIC_API_KEY=
# Optional ein bestimmtes Modell für alle Agenten:
# CLAUDE_MODEL=

# Tandoor (Einstellungen → API, Scope „read write“)
TANDOOR_URL=https://app.tandoor.dev
TANDOOR_TOKEN=

# Slack-App „Rezept-Helfer“ (slack-app-manifest.yml)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=
# optional: Manifest-Änderungen (neue Befehle) selbst in Slack einspielen
# App-ID: api.slack.com/apps → Rezept-Helfer → Basic Information → App ID (A0…)
# Token: api.slack.com/apps → ganz unten „Your App Configuration Tokens“ → Generate Token → den *Refresh Token* (xoxe-1-…)
SLACK_APP_ID=
SLACK_CONFIG_TOKEN=

# KI-Fotos für Rezepte ohne Bild
# Google Gemini „Nano Banana“ (sehr realistisch, ca. 0,03–0,04 $ pro Bild) – Schlüssel: aistudio.google.com → „Get API key“
# Ist der Schlüssel gesetzt, nimmt der Container Google; Cloudflare (unten) springt ein, wenn Google fehlschlägt.
GEMINI_API_KEY=
# Google-Modell (leer = gemini-nano-banana-2.1):
#   gemini-nano-banana-2.1  Nano Banana 2.1 – Standard, sehr gut, ca. 0,034 $
#   gemini-2.5-flash-image  Nano Banana (älter) – günstiger, ca. 0,039 $, etwas schwächer
#   gemini-3-pro-image      Nano Banana Pro – beste Qualität, ca. 0,13 $
GOOGLE_BILD_MODELL=gemini-nano-banana-2.1

# Rezepte aus Instagram-Reels und YouTube-Shorts: Gemini wertet das Video aus (nutzt GEMINI_API_KEY, unter 1 Cent pro Video)
# optional: GEMINI_VIDEO_MODELL=gemini-flash-latest, VIDEO_MAX_SEKUNDEN=600
# optional, falls Instagram ohne Anmeldung blockt: VIDEO_COOKIES=/data/daten/cookies.txt (Netscape-Format, am besten von einem Zweitkonto)

# Kostenlos über Cloudflare Workers AI (Free-Plan, FLUX)
# Account-ID: Cloudflare-Dashboard, Übersicht rechts · Token: Mein Profil → API-Tokens → Vorlage „Workers AI“
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# optional (kostenpflichtig): BILD_ANBIETER=openai, OPENAI_API_KEY=…
# BILD_ANBIETER=google|cloudflare|openai legt den Anbieter fest, sonst gilt: Google vor Cloudflare vor OpenAI
# optional: BILD_PRO_TAG=10
# Einheitlicher Bildstil (Standard an): neue Rezepte bekommen immer ein KI-Foto, Stil in agents/bild-stil.md; aus = Foto der Quelle nehmen
# optional: BILD_EINHEITLICH=an
# Für die Anzeige der freien Neuronen (/neuronen, nach jedem Foto) braucht der Token zusätzlich „Account Analytics: Read“.
# optional: CF_NEURONEN_PRO_TAG=10000

# Optional: Passwort für die Weboberfläche
# WEB_PASSWORT=

# Tägliche Sicherung aller Rezepte (JSON + Bild), gelöschter Rezepte und der Bild-Sicherungen in ein privates GitHub-Repo.
# Repo vorher auf GitHub privat anlegen; Token: GitHub → Settings → Developer settings → Fine-grained tokens,
# nur dieses Repo, „Contents: Read and write“. Uhrzeit in zeitplan.conf: rezept-sicherung = 03:30 (Standard).
# BACKUP_REPO=besitzer/rezepte-sicherung
# BACKUP_TOKEN=
# BACKUP_BRANCH=main

# Läuft ein Agent ins Claude-Limit, startet er alle N Minuten neu (Standard 30, höchstens 24 Stunden lang)
# CLAUDE_WIEDERHOLEN_MIN=30

# agents/ alle N Minuten aus GitHub holen (Standard 10, „aus“ = nie); optional anderes Repo/Branch
# AGENTS_SYNC=10
# auch app/ und slack-app-manifest.yml holen und bei neuem Code neu starten (Standard an, nur Ordner-Variante)
# APP_SYNC=an
# AGENTS_REPO=SebastianInTheWild/Rezept-Agent
# AGENTS_BRANCH=main

TZ=Europe/Berlin
