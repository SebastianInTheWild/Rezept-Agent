# Kopieren nach .env und ausfüllen. Die .env gehört nicht ins Repo.

# Home Assistant
HA_URL=http://192.168.11.252:8123
# Profil → Sicherheit → Langlebige Zugriffstoken → „Agenten“
HA_TOKEN=

# Claude: auf einem Rechner mit Claude Code „claude setup-token“ ausführen und den Token hier eintragen
CLAUDE_CODE_OAUTH_TOKEN=
# Alternativ ein API-Schlüssel (Abrechnung pro Lauf):
# ANTHROPIC_API_KEY=
# Optional ein bestimmtes Modell für alle Agenten:
# CLAUDE_MODEL=

# Wer den Push mit den Ergebnissen bekommt (kommagetrennt, Integration „Unser Zuhause“)
NOTIFY_PERSONS=person.sebastian

# Automationen mit diesem Label fasst der Agent nicht an
SKIP_LABEL=Test

TZ=Europe/Berlin
