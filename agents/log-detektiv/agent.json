{
  "name": "Log-Detektiv",
  "description": "Liest neue Fehler im HA-Protokoll, erklärt Ursache und Lösung und merkt sich harmlose Meldungen.",
  "icon": "mdi:text-search",
  "enabled": true,
  "schedule": [
    "07:30"
  ],
  "precheck": "node ha.mjs logs pending --count",
  "allowedTools": [
    "Bash(node ha.mjs logs pending)",
    "Bash(node ha.mjs logs harmless)",
    "Bash(node ha.mjs logs report)",
    "Bash(node ha.mjs states:*)",
    "Edit(/{{DATA}}/report.json)",
    "Read(/{{DATA}}/report.json)"
  ],
  "maxTurns": 25
}
